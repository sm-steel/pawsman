{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Every pin is bumped by automation: Cargo, mise tools, the Rust toolchain, GitHub Actions and `# renovate:` comments.",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "schedule": [
    "before 6am on monday"
  ],
  "semanticCommits": "enabled",
  "semanticCommitType": "chore",
  "semanticCommitScope": "deps",
  "labels": [
    "area:tooling"
  ],
  "rangeStrategy": "pin",
  "packageRules": [
    {
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "GitHub Actions"
    },
    {
      "matchManagers": [
        "rust-toolchain"
      ],
      "groupName": "Rust toolchain"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Versions annotated with `# renovate: datasource=… depName=…` on the line above.",
      "managerFilePatterns": [
        "/(^|/)lefthook\\.yml$/",
        "/(^|/)\\.github/workflows/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "(?:#|//) renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s*\\n[^\\n]*?(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "extractVersionTemplate": "^v?(?<version>.+)$"
    }
  ],
  "mode": "full"
}
